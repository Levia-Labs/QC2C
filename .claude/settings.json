{
  "model": "claude-opus-5-5",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "subagentPromptCacheTtl": "1h",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CREPIDOMA_POOL_TTL": "1800"
  },
  "permissions": {
    "allow": [
      "Bash(task *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git add *)",
      "Bash(graphify *)",
      "Bash(ruff *)",
      "Bash(yamllint *)",
      "Bash(pre-commit run *)",
      "Bash(claude --version)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(diff *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(echo *)",
      "Bash(test *)",
      "Bash(grep *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(command -v *)",
      "Bash(which *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "PowerShell",
      "ShareOnboardingGuide",
      "ListAgents",
      "Bash(sudo *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(task -t *)",
      "Bash(task * -t *)",
      "Bash(task *--taskfile*)",
      "Bash(task -d *)",
      "Bash(task * -d *)",
      "Bash(task *--dir*)",
      "Bash(pre-commit run -c *)",
      "Bash(pre-commit run *-c *)",
      "Bash(pre-commit run *--config*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit *--no-v*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git diff *--out*)",
      "Bash(git diff *--ext*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(git diff *--no-ind*)",
      "Bash(git diff *--no-index*)",
      "Bash(git diff * -O*)",
      "Bash(git diff -O*)",
      "Bash(git log *--out*)",
      "Bash(git log *--ext*)",
      "Bash(git log *--ext-diff*)",
      "Bash(git log *--no-ind*)",
      "Bash(git log *--no-index*)",
      "Bash(git log * -O*)",
      "Bash(git log -O*)",
      "Bash(git show *--out*)",
      "Bash(git show *--ext*)",
      "Bash(git show *--ext-diff*)",
      "Bash(git show *--no-ind*)",
      "Bash(git show *--no-index*)",
      "Bash(git show * -O*)",
      "Bash(git show -O*)",
      "Bash(task pr:merge *CONFIRM=yes*)"
    ]
  },
  "extraKnownMarketplaces": {
    "levia-labs": {
      "source": {
        "source": "github",
        "repo": "Levia-Labs/Crepidoma",
        "ref": "v0.6.4"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman",
        "ref": "v4.0.1"
      }
    }
  },
  "enabledPlugins": {
    "crepidoma@levia-labs": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "caveman@caveman": true
  }
}
